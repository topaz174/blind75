    {
      "id": "9OjGT4snRP5dGVLnc1tt3",
      "type": "text",
      "x": -186.14410665309276,
      "y": 496.3655107615214,
      "width": 369.06054547885697,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2Q",
      "roundness": null,
      "seed": 544948407,
      "version": 635,
      "versionNonce": 1699843831,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1780677056866,
      "link": null,
      "locked": false,
      "text": "holy shit i think i got it\nwe create two arrays, one called\nsmaller and one called greater\nthen we keep track of the max of\nthe smaller and the min of the\ngreater array\nthen we make sure that the current\nnode is greater than max of smaller\nand smaller than min of greater\nwait we dont even need arrays\nwe just keep track of a maxSmaller\nand a minGreater\nwe can call it maxLeft and minRight\nwhenever we go right\nyea yea this should work right",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "holy shit i think i got it\nwe create two arrays, one called smaller and one called greater\nthen we keep track of the max of the smaller and the min of the greater array\nthen we make sure that the current node is greater than max of smaller and smaller than min of greater\nwait we dont even need arrays\nwe just keep track of a maxSmaller and a minGreater\nwe can call it maxLeft and minRight\nwhenever we go right\nyea yea this should work right",
      "autoResize": false,
      "lineHeight": 1.25
    },
