      "updated": 1779628787294,
      "link": null,
      "locked": false,
      "text": "/*\n * @lc app=leetcode id=76 lang=cpp\n *\n * [76] Minimum Window Substring\n */\n\n// @lc code=start\n#include <unordered_map>\n#include <algorithm>\n#include <climits>\n#include <string> \n\nusing namespace std;\n\nclass Solution {\npublic:\n    string minWindow(string s, string t) {\n        int minLen = INT_MAX;\n        string minStr = \"\";\n        int l = 0;\n        unordered_map<char, int> freqs;\n        unordered_map<char, int> bank;\n\n        for (char c : t) {\n            freqs[c]++;\n            bank[c]++;\n        }\n\n        for (int r = 0; r < s.size(); ++r) {\n            // int currLen = r - l + 1;\n            cout << l << \" \" << r << endl;\n\n            if (freqs.count(s[r]))  {\n                // cout << s[r] << \": \" << bank[s[r]] << endl; \n                bank[s[r]]--;\n                if (bank[s[r]] <= 0) {\n                    bank.erase(s[r]);\n                }\n            }\n\n            while (bank.empty()) {\n                if (r - l + 1 < minLen) {\n                    // cout << \"currLen: \" << currLen << endl;\n                    minLen = r - l + 1;\n                    minStr = s.substr(l, r - l + 1);\n                    cout << \"minStr: \" << minStr << endl;\n                }\n                if (freqs.count(s[l])) {\n                    bank = freqs;\n                    l = r;\n                }\n                else {\n                    l++;\n                }\n            }\n        }\n\n        return minStr;\n    }\n};\n// @lc code=end\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "/*\n * @lc app=leetcode id=76 lang=cpp\n *\n * [76] Minimum Window Substring\n */\n\n// @lc code=start\n#include <unordered_map>\n#include <algorithm>\n#include <climits>\n#include <string> \n\nusing namespace std;\n\nclass Solution {\npublic:\n    string minWindow(string s, string t) {\n        int minLen = INT_MAX;\n        string minStr = \"\";\n        int l = 0;\n        unordered_map<char, int> freqs;\n        unordered_map<char, int> bank;\n\n        for (char c : t) {\n            freqs[c]++;\n            bank[c]++;\n        }\n\n        for (int r = 0; r < s.size(); ++r) {\n            // int currLen = r - l + 1;\n            cout << l << \" \" << r << endl;\n\n            if (freqs.count(s[r]))  {\n                // cout << s[r] << \": \" << bank[s[r]] << endl; \n                bank[s[r]]--;\n                if (bank[s[r]] <= 0) {\n                    bank.erase(s[r]);\n                }\n            }\n\n            while (bank.empty()) {\n                if (r - l + 1 < minLen) {\n                    // cout << \"currLen: \" << currLen << endl;\n                    minLen = r - l + 1;\n                    minStr = s.substr(l, r - l + 1);\n                    cout << \"minStr: \" << minStr << endl;\n                }\n                if (freqs.count(s[l])) {\n                    bank = freqs;\n                    l = r;\n                }\n                else {\n                    l++;\n                }\n            }\n        }\n\n        return minStr;\n    }\n};\n// @lc code=end\n\n",
