    {
      "id": "8WRH-dO6-HFbP8yFXEY6r",
      "type": "text",
      "x": 205.17413099830102,
      "y": 615.1351833057394,
      "width": 447.04435830630194,
      "height": 747.2015581435703,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
      "roundness": null,
      "seed": 1878706879,
      "version": 1967,
      "versionNonce": 1693925937,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779612592974,
      "link": null,
      "locked": false,
      "text": "then you compare these. if they arent equal,\nmove r till they are. if they are, move l till\nthey arent. when l is at its maximum for a\nfixed r (since theres no need to move r), you\nmove l to r+1, and let r increment. repeat till\nend of array, track min.\nok isnt that it??\nanother option is, for this second map, we\ncould have it be a duplicate of the first,\nthen instead of adding/incrementing, you\ndecrement then erase those with freq 0, then\ncheck if its equal. thats identical logic but\nremoves the \"overcounting\" probelm\nit also makes it so that you dont consider\nirrelevant letters at all.... \nso for the adobe window it'd just be {C:1}\nehhhh but idk the first one seems more\nstandard... but wait apparently TC for\ncomparing two hash maps is O(n) or even n²\nso nvm, lets do the emptying route\nnow the issue is dealing with l++. when u\nremove an element from the window, u have\nto add it back to the hm if its a char u\nwant, or ignore if not. I suppose to do that\nu would simply look at the original hm and see\nif its in it and if its freq in the 'current' hm\nis strictly lower. if so u do currenthm[s[l]]++\nor smth.\nand is that it? not too bad... lets simulate...\n",
      "fontSize": 19.925374883828542,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "then you compare these. if they arent equal, move r till they are. if they are, move l till they arent. when l is at its maximum for a fixed r (since theres no need to move r), you move l to r+1, and let r increment. repeat till end of array, track min.\nok isnt that it??\nanother option is, for this second map, we could have it be a duplicate of the first, then instead of adding/incrementing, you decrement then erase those with freq 0, then check if its equal. thats identical logic but removes the \"overcounting\" probelm\nit also makes it so that you dont consider irrelevant letters at all.... \nso for the adobe window it'd just be {C:1}\nehhhh but idk the first one seems more standard... but wait apparently TC for comparing two hash maps is O(n) or even n² so nvm, lets do the emptying route\nnow the issue is dealing with l++. when u remove an element from the window, u have to add it back to the hm if its a char u want, or ignore if not. I suppose to do that u would simply look at the original hm and see if its in it and if its freq in the 'current' hm is strictly lower. if so u do currenthm[s[l]]++ or smth.\nand is that it? not too bad... lets simulate...\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
