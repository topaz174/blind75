      "originalText": "/*\n * @lc app=leetcode id=76 lang=cpp\n *\n * [76] Minimum Window Substring\n */\n\n// @lc code=start\n#include <unordered_map>\n#include <algorithm>\n#include <climits>\n#include <string> \n\nusing namespace std;\n\nclass Solution {\npublic:\n    string minWindow(string s, string t) {\n        int minLen = INT_MAX;\n        string minStr = \"\";\n        int l = 0;\n        unordered_map<char, int> freqs;\n        unordered_map<char, int> bank;\n        int score = 0;\n\n        for (char c : t) {\n            freqs[c]++;\n            bank[c] = 0;\n        }\n\n        for (int r = 0; r < s.size(); ++r) {\n            // int currLen = r - l + 1;\n            // cout << l << \" \" << r << endl;\n\n            if (freqs.count(s[r]))  {\n                // cout << s[r] << \": \" << bank[s[r]] << endl; \n                if (bank[s[r]] < freqs[s[r]]) {\n                    score++;\n                    // cout << \"score++: \" << score << endl;\n                }\n                bank[s[r]]++;\n            }\n\n            while (score == t.length()) {\n                if (r - l + 1 < minLen) {\n                    // cout << \"currLen: \" << currLen << endl;\n                    minLen = r - l + 1;\n                    minStr = s.substr(l, r - l + 1);\n                    // cout << \"minStr: \" << minStr << endl;\n                }\n                if (freqs.count(s[l])) {\n                    if (bank[s[l]] <= freqs[s[l]]) {\n                        score--;\n                        // cout << s[r] << \": \" << bank[s[r]] << endl; \n                        // cout << \"score--: \" << score << endl;\n                    }\n\n                    bank[s[l]]--;\n                }\n                l++;\n            }\n        }\n\n        return minStr;\n    }\n};\n// @lc code=end\n\n\n\ni got an MLE here... 266/268 cases passed",
