    {
      "id": "MbbDEjNynqCoYx-bKKDAY",
      "type": "text",
      "x": 387.87838420636643,
      "y": 928.7479153026025,
      "width": 405.2398681640625,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
