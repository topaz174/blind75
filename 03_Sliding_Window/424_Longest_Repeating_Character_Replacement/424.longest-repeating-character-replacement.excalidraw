    {
      "id": "Pm8KCoIvpbeigEz1FULy8",
      "type": "text",
      "x": 1114.0005093421446,
      "y": 1438.0540436488413,
      "width": 56.29053595955396,
      "height": 37.936737809402764,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
