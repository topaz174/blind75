    {
      "id": "rEFaCvn12tct-7Mnm6ll7",
      "type": "text",
      "x": 1449.6075866550686,
      "y": 443.7862204871803,
      "width": 858,
      "height": 775,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1o",
      "roundness": null,
      "seed": 1485476065,
      "version": 87,
      "versionNonce": 1207456467,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779560191670,
      "link": null,
      "locked": false,
      "text": "class Solution {\npublic:\n    int characterReplacement(string s, int k) {\n        int maxLen = 0;\n\n        for (int l = 0; l <= s.size() - maxLen; ++l) {\n            int currLen = 0;\n            // int bound = min(static_cast<int>(s.size()) - 1, l + k);\n            int bound = l + k;\n            cout << \"bound: \" << bound << endl;\n\n            for (int r = l; r <= bound && r < s.size(); ++r) {\n                cout << l << \" \" << r << \" \" << endl;\n                if (s[l] == s[r]) {\n                    // bound = min(static_cast<int>(s.size()) - 1, bound + 1);\n                    bound++;\n                    cout << \"new bound: \" << bound << endl;\n                }\n                \n                if (r < bound) {\n                    currLen++;\n                }\n\n            }\n\n            maxLen = max(maxLen, currLen);\n        }\n        \n        return maxLen;\n    }\n};",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution {\npublic:\n    int characterReplacement(string s, int k) {\n        int maxLen = 0;\n\n        for (int l = 0; l <= s.size() - maxLen; ++l) {\n            int currLen = 0;\n            // int bound = min(static_cast<int>(s.size()) - 1, l + k);\n            int bound = l + k;\n            cout << \"bound: \" << bound << endl;\n\n            for (int r = l; r <= bound && r < s.size(); ++r) {\n                cout << l << \" \" << r << \" \" << endl;\n                if (s[l] == s[r]) {\n                    // bound = min(static_cast<int>(s.size()) - 1, bound + 1);\n                    bound++;\n                    cout << \"new bound: \" << bound << endl;\n                }\n                \n                if (r < bound) {\n                    currLen++;\n                }\n\n            }\n\n            maxLen = max(maxLen, currLen);\n        }\n        \n        return maxLen;\n    }\n};",
      "autoResize": true,
      "lineHeight": 1.25
    },
