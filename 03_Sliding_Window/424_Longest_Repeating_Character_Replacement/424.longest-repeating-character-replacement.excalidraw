      "seed": 1468568065,
      "version": 607,
      "versionNonce": 764722013,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779560191670,
      "link": null,
      "locked": false,
      "text": "maxlen = 0\nl=0:\n    len = 0\n    bound = l + k + 1 = 0 + 1 + 1 = 2\n    loop r from [l + 1, bound]:\n    r = 1:\n        *r == *l -> bound += 1 -> bound = 3\n        len = 1\n    r = 2:\n        *r != *l\n        len = 2\n    r = 3:\n        *r == *l -> bound = 4\n        len = 3\n    r = 4: \n        *r != *l -> bound = 4\n        len = 4\n        stop loop\n    maxlen = 4\n   \n        ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "maxlen = 0\nl=0:\n    len = 0\n    bound = l + k + 1 = 0 + 1 + 1 = 2\n    loop r from [l + 1, bound]:\n    r = 1:\n        *r == *l -> bound += 1 -> bound = 3\n        len = 1\n    r = 2:\n        *r != *l\n        len = 2\n    r = 3:\n        *r == *l -> bound = 4\n        len = 3\n    r = 4: \n        *r != *l -> bound = 4\n        len = 4\n        stop loop\n    maxlen = 4\n   \n        ",
      "autoResize": true,
      "lineHeight": 1.25
